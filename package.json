    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-admin": "^13.4.0",
    "impeccable": "^3.5.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.19.0",
