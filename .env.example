# Copy to .env and fill in. .env is gitignored; .env.example is not.

# firebase (default) or local.
#
# local seeds an in-memory store from sample-data.csv and stubs auth as signed
# in, so the app runs before the Firebase project exists. It has no access
# control, so vite.config.ts refuses to produce a production build in that
# mode. Use `npm run dev:local` rather than setting it here.
VITE_DATA_MODE=firebase

# Firebase console → Project settings → General → Your apps → Web app → Config.
# None of this is secret. The API key identifies the project; it is not a
# credential. The Firestore rules are what stop anyone reading the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your Google account's UID, the same one pasted into firestore.rules.
#
# Presentation only: it decides whether a signed-in stranger sees "this account
# does not have access" or a dead screen. It is not access control, and it is
# not a secret. Firebase console → Authentication → Users → User UID.
VITE_ALLOWED_UID=
